# ============================================================
# .htaccess — Configuración de seguridad Apache
# ============================================================

# Denegar acceso directo a carpetas sensibles desde .htaccess.
# DirectoryMatch no está permitido en este contexto de configuración.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:config|models|controllers|db)(?:/|$) - [F,L]
</IfModule>

# Denegar acceso al fichero .env
<Files ".env">
    Require all denied
</Files>

# Cabeceras de seguridad
<IfModule mod_headers.c>
    # Evitar que el navegador "adivine" el tipo de contenido
    Header set X-Content-Type-Options "nosniff"
    # Protección básica XSS en navegadores antiguos
    Header set X-XSS-Protection "1; mode=block"
    # No permitir que la página se cargue en un iframe (clickjacking)
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
